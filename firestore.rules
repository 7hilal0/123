rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Profiles are public, but only the authenticated owner can create or change one.
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // Posts are public. Authenticated users may create and interact with them.
    // The client is still responsible for author ownership; Firebase Auth prevents anonymous writes.
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    // A conversation can only be accessed by one of its participants.
    match /conversations/{conversationId} {
      allow read, write: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Notifications are readable only by their recipient; any signed-in actor may create one for a recipient.
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.recipientId != null;
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
